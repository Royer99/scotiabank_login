# ── MongoDB connection ────────────────────────────────────────────────────────
# Atlas SRV URI. Never commit the real one; .env is gitignored.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/
MONGODB_DB=scotiabank_login
MONGODB_COLLECTION=sessions
# Pool size per process. Must exceed per-Locust-worker concurrent users or the
# harness measures pool queuing and calls it database latency (asserted at start).
MONGODB_MAX_POOL_SIZE=500
MONGODB_READ_PREFERENCE=primary
MONGODB_WRITE_CONCERN=1

# ── Dataset shape ─────────────────────────────────────────────────────────────
# Headline scale.
TOTAL_DOCUMENT_COUNT=16000000
# Distinct customers owning sessions (power-law: retail online banking realistic).
# Roughly one customer per ~5 sessions across a rolling week.
SYNTHETIC_USER_COUNT=3200000
# Power-law shape for sessions-per-user (a few heavy users, most with one or two).
SESSIONS_PER_USER_SKEW=1.4
# Share of non-anonymous sessions carrying a profile block (email, name, phone).
# Anonymous sessions (~15%) are pre-login flows: password recovery, enrollment.
PROFILE_PRESENT_RATIO=0.85
# Average session document size in bytes (JWT + device + profile + padding).
PAYLOAD_TARGET_BYTES=2800
SESSION_TTL_DAYS=1
# Share of session docs generated with expiresAt in the past. Realistic for a
# rolling window snapshot; a real prod store expires them via a job or TTL.
EXPIRED_SESSION_RATIO=0.10
RANDOM_SEED=42
# TTL index on expiresAt. Default OFF: the dataset carries past expiries and
# would delete itself mid-benchmark if enabled.
ENABLE_TTL_INDEX=false

# ── Load ──────────────────────────────────────────────────────────────────────
# Generator+loader processes. Each owns a contiguous ID range; document content
# derives only from (RANDOM_SEED, kind, index), so parallelism is deterministic.
GENERATE_WORKERS=8
LOAD_BATCH_SIZE=1000
LOAD_CHECKPOINT_PATH=./.load_checkpoint.json

# ── Access distribution ───────────────────────────────────────────────────────
# Recency skew: HOT_ACCESS_SHARE of reads land in the most recent
# HOT_SET_RATIO of sessions. Report latency only next to this distribution.
HOT_SET_RATIO=0.05
HOT_ACCESS_SHARE=0.80

# ── Locust ────────────────────────────────────────────────────────────────────
LOCUST_USERS=500
LOCUST_SPAWN_RATE=50
LOCUST_RUN_TIME=10m
TARGET_READ_RPS=2000
# Share of total ops that are writes (update/insert).
WRITE_RATIO=0.10
# Share of reads that hit the per-user session list (userId_1 index).
USER_LOOKUP_RATIO=0.15
# Share of reads that hit the email lookup (email_1 partial index).
EMAIL_LOOKUP_RATIO=0.05
# Max sessions returned by get_user_sessions (tail by lastUsedDate).
USER_SESSIONS_LIMIT=25
READ_LATENCY_SLO_MS=10
